# Real files (CSS, JS, uploads, favicon) are served directly; everything else goes to the PHP front controller.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# www (http or https) goes to the bare domain over https in one hop, keeping the path (minus any trailing slash) and query.
RewriteCond %{HTTP_HOST} ^www\.prurientinterests\.me$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^/?(.*?)/*$ https://prurientinterests.me/$1 [R=301,L]

# A trailing slash is dropped (the home page keeps its one slash). Real folders are left alone.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/+$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]
